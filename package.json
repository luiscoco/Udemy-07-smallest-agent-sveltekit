{
  "name": "smallest-agent-sveltekit", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=24.0.0" },
  "imports": { "#lib/*": "./src/lib/*" },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 4800 --strictPort",
    "generate:lesson": "node scripts/generate-lesson.mjs",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --config vitest.server.config.ts && vitest run --config vitest.client.config.ts", "build": "npm run generate:lesson && vite build",
    "start": "node scripts/start.mjs"
  },
  "dependencies": { "@anthropic-ai/claude-agent-sdk": "0.3.319", "dotenv": "17.2.3", "dompurify": "3.4.17", "highlight.js": "11.12.0", "marked": "18.1.3" },
  "devDependencies": { "@sveltejs/adapter-node": "6.0.1", "@sveltejs/kit": "3.1.1", "@sveltejs/vite-plugin-svelte": "7.3.1", "svelte": "5.57.3", "svelte-check": "4.7.8", "typescript": "6.0.3", "vite": "8.3.6", "vitest": "5.1.0", "jsdom": "30.0.0", "@types/node": "24.10.1", "@testing-library/svelte": "5.4.2" }
}
